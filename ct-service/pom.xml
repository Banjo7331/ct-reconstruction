<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.ctrecon</groupId>
        <artifactId>ct-reconstruction</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>ct-service</artifactId>
    <name>CT Service</name>
    <description>Spring Boot application: REST API and adapters around the core, the engine and the MAT-file reader.</description>

    <dependencies>
        <dependency>
            <groupId>dev.ctrecon</groupId>
            <artifactId>ct-core</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.ctrecon</groupId>
            <artifactId>ct-engine</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.ctrecon</groupId>
            <artifactId>ct-matlab</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>ct-service</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
